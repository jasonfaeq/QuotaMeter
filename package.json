{
  "name": "quotameter",
  "version": "1.0.0",
  "description": "Multi-account quota monitor for Codex, Claude, and Antigravity with a responsive terminal UI",
  "author": "JasonFaeq",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonfaeq/QuotaMeter.git"
  },
  "homepage": "https://github.com/jasonfaeq/QuotaMeter#readme",
  "bugs": {
    "url": "https://github.com/jasonfaeq/QuotaMeter/issues"
  },
  "files": [
    "quotameter.js",
    "quotameter-server.js",
    "lib/",
    "web/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "quotameter": "./quotameter.js",
    "qm": "./quotameter.js",
    "quotameter-server": "./quotameter-server.js"
  },
  "scripts": {
    "start": "node quotameter.js",
    "app": "node quotameter-server.js",
    "test": "bun test",
    "preflight": "node scripts/preflight.js",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "release:pack": "bun pm pack --dry-run",
    "release:publish": "bun publish --access public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
